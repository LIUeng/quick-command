{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the launcher window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "global-shortcut:default",
    "process:allow-restart",
    "updater:default"
  ]
}
